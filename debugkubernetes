#!/bin/bash
export GUM_FILTER_PROMPT="❯ "
export GUM_FILTER_PROMPT_FOREGROUND="#38BDF8"
export GUM_FILTER_INDICATOR="▸"
export GUM_FILTER_INDICATOR_FOREGROUND="#38BDF8"
export GUM_FILTER_MATCH_FOREGROUND="#FBBF24"
export GUM_FILTER_HEADER_FOREGROUND="#7DD3FC"
export GUM_FILTER_HEADER_BOLD=true
export GUM_FILTER_PLACEHOLDER_FOREGROUND="#64748B"
acr=smartaquarius10/kubelogin:latest
namespace=${1:-default}

cleanup() {
    if [ -n "$debugpod" ]; then
        debugpod=$(kubectl get pods -n "$namespace" | awk '{print $1}' | grep "node-debugger-$debugpod")
        [ -n "$debugpod" ] && kubectl delete pod "$debugpod" -n "$namespace"
    fi
}
trap 'trap - EXIT; cleanup; exit 0' SIGINT
trap 'cleanup' EXIT

echo
echo "Login into nodes (namespace: $namespace)"
echo

# Get node names, stripped of "node/" prefix for display
mapfile -t nodes < <(kubectl get nodes -o name | sed 's|node/||')

if [ ${#nodes[@]} -eq 0 ]; then
    echo "No nodes found."
    exit 1
fi

if ! command -v gum &> /dev/null; then
    echo "gum not installed. Falling back to numbered list."
    PS3=$'\nSelect a node (number): '
    select selected_node in "${nodes[@]}"; do
        [[ -n "$selected_node" ]] && break
    done
else
    selected_node=$(printf '%s\n' "${nodes[@]}" | gum filter --header="Select a node:" --height=15)
fi

if [[ -z "$selected_node" ]]; then
    echo "No node selected. Exiting..."
    exit 1
fi

debugpod=$selected_node
kubectl debug "node/$selected_node" -it -n "$namespace" --image="$acr"
